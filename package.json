{
	"name": "@mmmike/web-push",
	"version": "1.3.0",
	"description": "Zero-dependency Web Push (RFC 8291) for Cloudflare Workers, Deno, Bun, Node.js, and browsers — client subscribe + server send + VAPID.",
	"keywords": [
		"bun",
		"cloudflare-workers",
		"deno",
		"edge-runtime",
		"notifications",
		"push-notifications",
		"rfc8291",
		"service-worker",
		"vapid",
		"web-crypto",
		"web-push",
		"webpush"
	],
	"homepage": "https://github.com/MMMikeM/web-push#readme",
	"bugs": {
		"url": "https://github.com/MMMikeM/web-push/issues"
	},
	"license": "MIT",
	"author": "Mike Murray",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MMMikeM/web-push.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./vapid": {
			"types": "./dist/vapid.d.mts",
			"default": "./dist/vapid.mjs"
		},
		"./send": {
			"types": "./dist/send.d.mts",
			"default": "./dist/send.mjs"
		},
		"./client": {
			"types": "./dist/client.d.mts",
			"default": "./dist/client.mjs"
		}
	},
	"scripts": {
		"build": "vp pack",
		"lint": "vp lint src test scripts examples",
		"lint:types": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json",
		"format": "vp fmt --write",
		"format:check": "vp fmt --check",
		"test": "vp test run",
		"test:watch": "vp test",
		"coverage": "vp test run --coverage",
		"audit": "pnpm audit --audit-level high --ignore-registry-errors",
		"check": "pnpm run format:check && pnpm run lint && pnpm run lint:types && pnpm run test && pnpm run audit",
		"check:exports": "attw --pack . --profile esm-only",
		"check:publint": "publint --strict",
		"check:sizes": "node scripts/check-sizes.ts",
		"check:package": "pnpm run build && pnpm run check:publint && pnpm run check:exports && pnpm run check:sizes",
		"prepublishOnly": "pnpm run check && pnpm run check:package",
		"release": "git tag -a \"v$npm_package_version\" -m \"v$npm_package_version\" && git push --follow-tags"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@arethetypeswrong/core": "^0.18.5",
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"publint": "^0.3.21",
		"typescript": "^7.0.2",
		"vite-plus": "^0.2.8"
	},
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "pnpm@11.17.0"
}
