{
	"name": "@mmmike/web-push",
	"version": "1.4.3",
	"description": "Subscribe in the browser and send VAPID-signed, RFC 8291 encrypted push notifications from Cloudflare Workers, Deno, Bun or Node, with one zero-dependency package.",
	"keywords": [
		"bun",
		"cloudflare-workers",
		"deno",
		"edge-runtime",
		"nodejs",
		"notifications",
		"push-notifications",
		"rfc8291",
		"rfc8292",
		"service-worker",
		"vapid",
		"web-crypto",
		"web-push",
		"webpush"
	],
	"homepage": "https://web-push.thelazyweb.dev/",
	"bugs": {
		"url": "https://github.com/MMMikeM/web-push/issues"
	},
	"license": "MIT",
	"author": "Mike Murray",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MMMikeM/web-push.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./vapid": {
			"types": "./dist/vapid.d.mts",
			"default": "./dist/vapid.mjs"
		},
		"./send": {
			"types": "./dist/send.d.mts",
			"default": "./dist/send.mjs"
		},
		"./client": {
			"types": "./dist/client.d.mts",
			"default": "./dist/client.mjs"
		}
	},
	"scripts": {
		"build": "vp pack",
		"lint": "vp lint src test scripts examples",
		"lint:types": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json",
		"format": "vp fmt --write",
		"format:check": "vp fmt --check",
		"test": "vp test run",
		"test:watch": "vp test",
		"coverage": "vp test run --coverage",
		"audit": "pnpm audit --audit-level high --ignore-registry-errors",
		"check": "pnpm run format:check && pnpm run lint && pnpm run lint:types && pnpm run coverage && pnpm run audit",
		"check:sizes": "node scripts/check-sizes.ts",
		"check:package": "pnpm run build && pnpm run check:sizes",
		"prepublishOnly": "pnpm run check && pnpm run check:package",
		"release": "git tag -a \"v$npm_package_version\" -m \"v$npm_package_version\" && git push --follow-tags"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"esbuild": "^0.28.2",
		"publint": "^0.3.25",
		"typescript": "^7.0.2",
		"vite-plus": "^1.3.0"
	},
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "pnpm@12.14.0"
}
