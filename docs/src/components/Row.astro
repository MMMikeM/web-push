---
import NoteConnector from "./NoteConnector.astro";

interface Props {
	id?: string;
	/** The `for` of the row's margin note, to draw its arrow to a `NoteTarget`. Not `note`, which Astro reserves for the slot. */
	noteFor?: string;
	approach?: "side" | "above" | "below";
	/** Lowers the note beside the main column, to line its arrow up with a first line that sits lower. */
	noteOffset?: string;
}

const { id, noteFor, approach = "side", noteOffset } = Astro.props;
---

<div
	class:list={["row", { "arc-above": noteFor && approach === "above" }]}
	id={id}
	style={noteOffset && `--note-offset: ${noteOffset}`}
>
	<div class="columns">
		<div class="main"><slot /></div>
		<slot name="note" />
	</div>
	{noteFor && <NoteConnector for={noteFor} approach={approach} />}
</div>

<style>
	.row {
		container-type: inline-size;
	}

	/* Room for an arrow that arcs down onto the first line. */
	.row + .row,
	.arc-above {
		margin-top: 2.25rem;
	}

	.columns {
		display: grid;
		gap: 0.75rem;
	}

	.columns > :global(.margin-note) {
		margin-top: 0;
	}

	.main {
		min-width: 0;
	}

	@container (min-width: 52rem) {
		.columns {
			grid-template-columns: fit-content(36em) 14rem;
			justify-content: start;
			column-gap: 2.5rem;
		}

		.columns > :global(.margin-note) {
			margin-top: var(--note-offset, 0);
			--margin-note-up: none;
			--margin-note-left: block;
		}
	}
</style>
