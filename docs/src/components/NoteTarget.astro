---
interface Props {
	/** The `for` of the margin note that points here. */
	for: string;
	as?: "span" | "li" | "mark";
}

const { for: id, as: Tag = "span" } = Astro.props;
---

<Tag class="note-target" data-note-target={id} style={`anchor-name: --target-${id}`}><slot /></Tag>

<style>
	/* A phrase that wraps has no single end for an arrow to reach. */
	@container (min-width: 52rem) {
		.note-target {
			white-space: nowrap;
		}
	}
</style>
