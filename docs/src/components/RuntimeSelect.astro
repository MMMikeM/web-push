---
import { Icon } from "@astrojs/starlight/components";
import Select from "@astrojs/starlight/components/Select.astro";

interface Props {
	/** Beside a page title rather than in the header, so it carries a visible label. */
	inline?: boolean;
}

const { inline = false } = Astro.props;
const RUNTIMES = ["Node", "Bun", "Deno", "Cloudflare Workers", "Vercel Edge"];
---

<runtime-select class="not-content">
	{
		inline ? (
			<label class="inline-control">
				<span class="inline-label">Runtime</span>
				<select autocomplete="off">
					{RUNTIMES.map((runtime, index) => (
						<option value={runtime} selected={index === 0}>
							{runtime}
						</option>
					))}
				</select>
				<Icon name="down-caret" class="inline-caret" />
			</label>
		) : (
			<Select
				icon="setting"
				label="Runtime"
				width="13em"
				options={RUNTIMES.map((runtime, index) => ({
					label: runtime,
					value: runtime,
					selected: index === 0,
				}))}
			/>
		)
	}
</runtime-select>

<script>
	// Starlight remembers synced tabs under this key, so the menu, the tabs, and
	// the choice carried between pages all stay in step.
	const STORAGE_KEY = "starlight-synced-tabs__runtime";

	const readStored = (): string | null => {
		try {
			return localStorage.getItem(STORAGE_KEY);
		} catch {
			return null;
		}
	};

	const showRuntime = (runtime: string) => {
		// The header and a page can each carry a menu; keep every copy on the same runtime.
		for (const select of document.querySelectorAll<HTMLSelectElement>("runtime-select select")) {
			select.value = runtime;
		}
		for (const tabs of document.querySelectorAll('starlight-tabs[data-sync-key="runtime"]')) {
			const tab = [...tabs.querySelectorAll<HTMLElement>('[role="tab"]')].find(
				(candidate) => candidate.textContent?.trim() === runtime,
			);
			// A block without this runtime shows its own tabs, so the fallback is visible.
			tabs.toggleAttribute("data-runtime-missing", !tab);
			// Starlight already restored the remembered runtime on load; clicking a
			// selected tab again would only move focus onto it.
			if (tab && tab.getAttribute("aria-selected") !== "true") {
				tab.click();
			}
		}
		try {
			localStorage.setItem(STORAGE_KEY, runtime);
		} catch {
			// Private windows can refuse storage; the choice then lasts for this page.
		}
	};

	class RuntimeSelect extends HTMLElement {
		connectedCallback() {
			const select = this.querySelector("select");
			if (!select) {
				return;
			}
			const stored = readStored();
			if (stored && [...select.options].some((option) => option.value === stored)) {
				select.value = stored;
			}
			document.documentElement.dataset.runtimeSelect = "";
			showRuntime(select.value);
			select.addEventListener("change", () => {
				showRuntime(select.value);
				// Clicking a tab focuses it, and the tab bar is hidden.
				select.focus();
			});
		}
	}

	customElements.define("runtime-select", RuntimeSelect);
</script>

<style>
	/* Starlight's select stretches to its container; in page content that is the full column. */
	runtime-select {
		display: inline-flex;
		vertical-align: middle;
	}

	.inline-control {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding-inline: 0.75rem 2rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background-color: var(--sl-color-gray-6);
		/* Below 16px, iOS zooms the page when the menu takes focus. */
		font-size: var(--text-base);
		transition: border-color 0.15s ease;
	}

	.inline-control:is(:hover, :focus-within) {
		border-color: var(--sl-color-gray-3);
	}

	.inline-control:has(select:focus-visible) {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

	.inline-label {
		color: var(--sl-color-gray-3);
	}

	.inline-control select {
		/* Size to the chosen runtime rather than the longest; others fall back to that. */
		field-sizing: content;
		min-height: 2.75rem;
		padding-block: 0;
		border: 0;
		outline: none;
		background: transparent;
		color: var(--sl-color-white);
		font: inherit;
		cursor: pointer;
		appearance: none;
	}

	.inline-control option {
		background-color: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-1);
	}

	.inline-control :global(.inline-caret) {
		position: absolute;
		inset-inline-end: 0.625rem;
		font-size: var(--text-base);
		color: var(--sl-color-gray-3);
		pointer-events: none;
	}
</style>
