---
import Default from "@astrojs/starlight/components/Footer.astro";
import { project } from "../project.ts";

const isHome = Astro.locals.starlightRoute.id === "";
const githubUser = new URL(project.repositoryUrl).pathname.split("/")[1];
---

{
	isHome ? (
		<div class="address" data-pagefind-ignore>
			<p class="lines">
				<span class="heading">Author's Address</span>
				<span>{project.author}</span>
				<a href="https://thelazyweb.dev">thelazyweb.dev</a>
				<span class="muted">GitHub: {githubUser}</span>
			</p>
			<p class="links">
				<a href={project.licenseFileUrl}>{project.license} licence</a>
				<a href={project.npmUrl}>npm</a>
				<a href={project.changelogUrl}>Changelog</a>
				<a href={project.repositoryUrl}>GitHub</a>
			</p>
		</div>
	) : (
		<>
			<Default />
			<p class="project-meta" data-pagefind-ignore>
				<a href={project.licenseFileUrl}>{project.license} licensed</a>
				<span aria-hidden="true">·</span>
				<a href={project.npmUrl}>npm</a>
				<span aria-hidden="true">·</span>
				<a href={project.changelogUrl}>Changelog</a>
				<span aria-hidden="true">·</span>
				<span>By {project.author}</span>
			</p>
		</>
	)
}

<style>
	.project-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 0.5rem;
		margin-top: 2rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.project-meta a {
		color: inherit;
		text-decoration: none;
	}

	.project-meta a:hover {
		color: var(--sl-color-white);
	}

	/* The band runs to the window's edges, past the content column it sits in. */
	.address {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2rem;
		margin-top: 4rem;
		padding-block: 3.5rem;
		border-top: 1px solid;
		border-image: linear-gradient(var(--line), var(--line)) 1 / 1px 0 0 / 0 100vmax;
		background: var(--paper-alt);
		box-shadow: 0 0 0 100vmax var(--paper-alt);
		clip-path: inset(0 -100vmax);
		font-size: var(--sl-text-sm);
		line-height: 1.8;
	}

	.address p {
		display: flex;
		margin: 0;
	}

	.lines {
		flex-direction: column;
	}

	.heading {
		margin-bottom: 0.5rem;
		font-size: var(--sl-text-base);
		font-weight: 500;
	}

	.muted {
		color: var(--ink-muted);
	}

	.address a {
		color: var(--pen);
	}

	.links {
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
	}

	.links a {
		padding-block: 0.625rem;
	}
</style>
