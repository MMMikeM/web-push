---
import { type PenArrow, penArrowPath } from "./pen-arrow.ts";

/** Beside the anchor: px from the top left of the block that holds the note and its anchor. */
type Beside = { left: number; top: number; width?: number; rotate: number; arrow?: PenArrow };

/** In the flow straight after the anchor. */
type Below = {
	/** How far in from the start of the block, or `auto` to sit at its end. */
	indent: string;
	rotate: number;
	width?: string;
	/** Margin above and below, to tuck the note against the next element. */
	space?: string;
	/** Shown above the anchor instead, though it still follows it for screen readers. */
	before?: boolean;
	arrow?: PenArrow;
};

interface Props {
	/** On pages 66rem and wider. */
	wide: Beside;
	/** In the left gutter, which only has room for a note in an 85rem viewport. */
	gutter?: Beside;
	narrow: Below;
}

const { wide, gutter, narrow } = Astro.props;

const besideVars = (prefix: string, { left, top, width = 260, rotate }: Beside) => ({
	[`--${prefix}-left`]: `${left}px`,
	[`--${prefix}-top`]: `${top}px`,
	[`--${prefix}-width`]: `${width}px`,
	[`--${prefix}-rotate`]: `${rotate}deg`,
});

const style = {
	"--narrow-indent": narrow.indent,
	"--narrow-width": narrow.width ?? "min(16rem, 70%)",
	"--narrow-rotate": `${narrow.rotate}deg`,
	"--narrow-space": narrow.space ?? "0.75rem 0",
	"--narrow-order": narrow.before ? "-1" : "0",
	...besideVars("wide", wide),
	...(gutter && besideVars("gutter", gutter)),
};

const arrows = Object.entries({ narrow: narrow.arrow, wide: wide.arrow, gutter: gutter?.arrow }).filter(
	(entry): entry is [string, PenArrow] => entry[1] !== undefined,
);
---

<div
	class="margin-note decoration"
	role="note"
	data-pagefind-ignore
	data-gutter={gutter && ""}
	style={style}
>
	<div class="text"><slot /></div>
	{
		arrows.map(([at, arrow]) => (
			<svg
				class="arrow"
				data-at={at}
				data-corner={arrow.corner}
				aria-hidden="true"
				width="1"
				height="1"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d={penArrowPath(arrow)} />
			</svg>
		))
	}
</div>

<style>
	.margin-note {
		position: relative;
		order: var(--narrow-order);
		width: var(--narrow-width);
		margin-block: var(--narrow-space);
		margin-inline-start: var(--narrow-indent);
		color: var(--pen);
		font-size: 1rem;
		font-style: italic;
		line-height: 1.4;
		text-wrap: pretty;
	}

	.text {
		rotate: var(--narrow-rotate);
	}

	.text :global(p) {
		margin: 0;
	}

	.text :global(code) {
		padding: 0;
		background: none;
		color: inherit;
		font-style: normal;
		font-size: 0.88em;
	}

	/* No margin: Starlight spaces any element that follows another in Markdown content. */
	.arrow {
		position: absolute;
		inset: 0 auto auto 0;
		display: none;
		margin: 0;
		overflow: visible;
	}

	.arrow[data-corner="bottom"] {
		inset: auto auto 0 0;
	}

	.arrow[data-at="narrow"] {
		display: block;
	}

	@container page (min-width: 66rem) {
		.margin-note {
			position: absolute;
			top: var(--wide-top);
			left: var(--wide-left);
			width: var(--wide-width);
			margin: 0;
			font-size: 1.0625rem;
		}

		.text {
			rotate: var(--wide-rotate);
		}

		.arrow[data-at="narrow"] {
			display: none;
		}

		.arrow[data-at="wide"] {
			display: block;
		}
	}

	@media (min-width: 85rem) {
		.margin-note[data-gutter] {
			top: var(--gutter-top);
			left: var(--gutter-left);
			width: var(--gutter-width);
		}

		[data-gutter] .text {
			rotate: var(--gutter-rotate);
		}

		[data-gutter] .arrow[data-at="wide"] {
			display: none;
		}

		[data-gutter] .arrow[data-at="gutter"] {
			display: block;
		}
	}
</style>
