---
import { notePlacements, placementCss, ranges } from "../margin-notes.ts";
import { penArrowPath } from "./pen-arrow.ts";

interface Props {
	/** Its key in margin-notes.json, which holds where it sits at each width. */
	id: string;
}

const { id } = Astro.props;
const placements = notePlacements[id];
if (!placements) {
	throw new Error(`margin-notes.json has no placements for the margin note "${id}"`);
}
const arrows = ranges(placements).flatMap(({ from, placement }) =>
	placement.arrow ? [{ at: from, arrow: placement.arrow }] : [],
);
---

<div
	class="margin-note decoration"
	role="note"
	data-pagefind-ignore
	data-note={id}
	data-placements={import.meta.env.DEV ? JSON.stringify(placements) : undefined}
>
	<div class="text"><slot /></div>
	{
		arrows.map(({ at, arrow }) => (
			<svg
				class="arrow"
				data-at={at}
				data-corner={arrow.corner}
				aria-hidden="true"
				width="1"
				height="1"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d={penArrowPath(arrow)} />
			</svg>
		))
	}
	<style is:inline data-note-style={id} set:html={placementCss(id, placements)} />
</div>

<style>
	.margin-note {
		color: var(--pen);
		font-style: italic;
		line-height: 1.4;
		text-wrap: pretty;
	}

	.text :global(p) {
		margin: 0;
	}

	.text :global(code) {
		padding: 0;
		background: none;
		color: inherit;
		font-style: normal;
		font-size: 0.88em;
	}

	/* No margin: Starlight spaces any element that follows another in Markdown content. */
	.arrow {
		position: absolute;
		inset: 0 auto auto 0;
		display: none;
		margin: 0;
		overflow: visible;
	}

	.arrow[data-corner="bottom"] {
		inset: auto auto 0 0;
	}
</style>
