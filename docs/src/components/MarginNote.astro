---
interface Props {
	/** Names the note, so a `NoteTarget` and `NoteConnector` with the same `for` draw its arrow. */
	for?: string;
}

const { for: id } = Astro.props;
---

<div
	class:list={["margin-note decoration", { connected: id }]}
	role="note"
	data-pagefind-ignore
	data-note={id}
	style={id && `anchor-name: --note-${id}`}
>
	<span class="mark" aria-hidden="true">
		<svg
			class="up"
			width="28"
			height="22"
			viewBox="0 0 28 22"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M26 18C18 18 8 14 4 4"></path>
			<path d="M2 9L4 4L9 6"></path>
		</svg>
		<svg
			class="left"
			width="28"
			height="16"
			viewBox="0 0 28 16"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M27 12C19 13 11 8 3 8"></path>
			<path d="M7 4.5L3 8L7 11.5"></path>
		</svg>
	</span>
	<div class="text"><slot /></div>
</div>

<style>
	.margin-note {
		display: flex;
		align-items: flex-start;
		gap: 0.625rem;
		color: var(--pen);
		font-style: italic;
		font-size: var(--sl-text-lg);
		line-height: 1.45;
	}

	.mark {
		flex: none;
	}

	/* Up at the paragraph above, unless a layout puts the note beside it and swaps the arrows. */
	.up {
		display: var(--margin-note-up, block);
		margin-top: 0.125rem;
	}

	/* Hangs into the gutter, so the tip reaches towards the text. */
	.left {
		display: var(--margin-note-left, none);
		margin-top: 0.3rem;
		margin-inline-start: -1.5rem;
		max-width: none;
	}

	/* A connected note's arrow is drawn to its target instead. */
	.connected .left {
		display: none;
	}

	.text :global(p) {
		margin: 0;
	}

	.text :global(code) {
		padding: 0;
		background: none;
		color: inherit;
		font-style: normal;
		font-size: 0.85em;
	}
</style>
