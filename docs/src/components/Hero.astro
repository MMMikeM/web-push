---
import { LinkButton } from "@astrojs/starlight/components";
import { project } from "../project.ts";
import MarginNote from "./MarginNote.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const highlight = data.heroHighlight;
const note = data.heroNote;
const [beforeAnchor, afterAnchor] =
	tagline && note && tagline.includes(note.target) ? tagline.split(note.target) : [tagline];
const [beforeHighlight, afterHighlight] =
	highlight && title.includes(highlight) ? title.split(highlight) : [title];

const install = `npm install ${project.name}`;
const issueUrl = `${project.repositoryUrl}/issues/new`;
const initialledAuthor = project.author.replace(/^(\S)\S*\s+/, "$1. ");
const published = new Date().toLocaleDateString("en-GB", { month: "long", year: "numeric" });
---

<div class="rfc-header decoration" data-pagefind-ignore>
	<p>
		<span class="wide-only">Independent Submission</span>
		<span class="narrow-only"
			>Informational · {initialledAuthor} · <a href="https://thelazyweb.dev">thelazyweb.dev</a></span
		>
		<span>Request for Comments: <a href={issueUrl}>open an issue</a></span>
		<span class="wide-only">Category: Informational</span>
	</p>
	<p class="end wide-only">
		<span>{initialledAuthor}</span>
		<a href="https://thelazyweb.dev">thelazyweb.dev</a>
		<span>{published}</span>
	</p>
</div>

<div class="lead">
	<div class="hero">
		<h1 id="_top" data-page-title>
			{beforeHighlight}{afterHighlight !== undefined && <mark>{highlight}</mark>}{afterHighlight}
		</h1>
		{
			tagline && (
				<div class="tagline">
					<p>
						{beforeAnchor}
						{afterAnchor !== undefined && <u>{note?.target}</u>}
						{afterAnchor}
					</p>
					{note && <MarginNote id="hero">{note.text}</MarginNote>}
				</div>
			)
		}
		<div class="actions">
			{actions.map(({ link, text, variant, icon }) => (
				<LinkButton href={link} variant={variant} icon={icon?.name}>
					{text}
				</LinkButton>
			))}
		</div>
		<div class="install">
			<code><span class="prompt decoration" aria-hidden="true">$ </span>{install}</code>
			<button type="button" class="decoration" aria-label="Copy the install command" data-copy={install}>
				<svg
					aria-hidden="true"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<rect x="9" y="9" width="12" height="12" rx="2"></rect>
					<path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
				</svg>
			</button>
		</div>
	</div>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
		button.addEventListener("click", async () => {
			await navigator.clipboard.writeText(button.dataset.copy ?? "");
			button.dataset.copied = "";
			setTimeout(() => delete button.dataset.copied, 1500);
		});
	}
</script>

<style>
	.rfc-header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2.5rem;
		padding-top: 2.5rem;
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-sm);
		line-height: 1.7;
	}

	.rfc-header p {
		display: flex;
		flex-direction: column;
		margin: 0;
	}

	/* Grows what a finger can hit; the negative margin keeps the rows where they were. */
	.rfc-header a {
		margin-block: -0.875rem;
		padding-block: 0.875rem;
		color: var(--pen);
	}

	.rfc-header .end {
		text-align: end;
	}

	@media (max-width: 39.99rem) {
		.rfc-header {
			padding-top: 1.25rem;
			font-size: var(--sl-text-xs);
		}

		.rfc-header .wide-only {
			display: none;
		}
	}

	@media (min-width: 40rem) {
		.rfc-header .narrow-only {
			display: none;
		}
	}

	.lead {
		container: page / inline-size;
	}

	.hero {
		display: grid;
		gap: 1.75rem;
		padding-block: 1.5rem 0.5rem;
	}

	h1 {
		margin: 0;
		color: var(--ink);
		font-size: clamp(2.5rem, 6vw, 4.125rem);
		font-weight: 600;
		line-height: 1.08;
	}

	/*
	 * Source Serif's inline box is 1.38em tall, more than the heading's line height,
	 * so the yellow runs from just above the ascenders to just below the descenders
	 * and clears the line above.
	 */
	h1 mark {
		background: linear-gradient(transparent 19%, var(--highlight) 19% 97%, transparent 97%);
	}

	.tagline {
		position: relative;
		display: flex;
		flex-direction: column;
		max-width: 34em;
		color: var(--ink-muted);
		font-size: var(--sl-text-xl);
		line-height: 1.6;
	}

	.tagline p {
		margin: 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
	}

	.actions :global(.sl-link-button) {
		min-height: 2.75rem;
		align-items: center;
	}

	.install {
		justify-self: start;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		max-width: 100%;
		box-sizing: border-box;
		padding: 0.25rem 0.25rem 0.25rem 1.125rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		font-size: var(--sl-text-sm);
	}

	.install code {
		overflow-x: auto;
		white-space: nowrap;
	}

	.prompt {
		color: var(--ink-muted);
	}

	.install button {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--ink-muted);
		cursor: pointer;
	}

	.install button:hover,
	.install button[data-copied] {
		color: var(--ink);
	}

	@container page (min-width: 52rem) {
		.hero {
			padding-block: 3.5rem 1.5rem;
		}
	}
</style>
