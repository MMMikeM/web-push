---
import { LinkButton } from "@astrojs/starlight/components";
import { project } from "../project.ts";
import MarginNote from "./MarginNote.astro";
import NoteConnector from "./NoteConnector.astro";
import NoteTarget from "./NoteTarget.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const highlight = data.heroHighlight;
const note = data.heroNote;
const [beforeNoteTarget, afterNoteTarget] =
	tagline && note && tagline.includes(note.target) ? tagline.split(note.target) : [tagline];
const [beforeHighlight, afterHighlight] =
	highlight && title.includes(highlight) ? title.split(highlight) : [title];

const install = `npm install ${project.name}`;
const initialledAuthor = project.author.replace(/^(\S)\S*\s+/, "$1. ");
const published = new Date().toLocaleDateString("en-GB", { month: "long", year: "numeric" });
---

<div class="rfc-header decoration" data-pagefind-ignore>
	<p>
		<span>Independent Submission</span>
		<span>Request for Comments: <a href={`${project.repositoryUrl}/issues/new`}>open an issue</a></span>
		<span>Category: Informational</span>
	</p>
	<p class="end">
		<span>{initialledAuthor}</span>
		<a href="https://thelazyweb.dev">thelazyweb.dev</a>
		<span>{published}</span>
	</p>
</div>

<div class="lead">
	<div class="hero">
		<h1 id="_top" data-page-title>
			{beforeHighlight}{afterHighlight !== undefined && <mark>{highlight}</mark>}{afterHighlight}
		</h1>
		{
			tagline && (
				<p class="tagline">
					{beforeNoteTarget}
					{afterNoteTarget !== undefined && <NoteTarget for="hero">{note?.target}</NoteTarget>}
					{afterNoteTarget}
				</p>
			)
		}
		{note && <MarginNote for="hero">{note.text}</MarginNote>}
		<div class="actions">
			{actions.map(({ link, text, variant, icon }) => (
				<LinkButton href={link} variant={variant} icon={icon?.name}>
					{text}
				</LinkButton>
			))}
		</div>
		<div class="install">
			<code><span class="prompt decoration" aria-hidden="true">$ </span>{install}</code>
			<button type="button" class="decoration" aria-label="Copy the install command" data-copy={install}>
				<svg
					aria-hidden="true"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<rect x="9" y="9" width="12" height="12" rx="2"></rect>
					<path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
				</svg>
			</button>
		</div>
		{note && afterNoteTarget !== undefined && <NoteConnector for="hero" approach="side" />}
	</div>
</div>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
		button.addEventListener("click", async () => {
			await navigator.clipboard.writeText(button.dataset.copy ?? "");
			button.dataset.copied = "";
			setTimeout(() => delete button.dataset.copied, 1500);
		});
	}
</script>

<style>
	.rfc-header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2.5rem;
		padding-top: 2.5rem;
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-sm);
		line-height: 1.7;
	}

	.rfc-header p {
		display: flex;
		flex-direction: column;
		margin: 0;
	}

	.rfc-header a {
		color: var(--pen);
	}

	@media (min-width: 40rem) {
		.rfc-header .end {
			text-align: end;
		}
	}

	.lead {
		container-type: inline-size;
	}

	.hero {
		position: relative;
		display: grid;
		grid-template-areas: "title" "tagline" "note" "actions" "install";
		gap: 1.75rem;
		padding-block: 3.5rem 5rem;
	}

	.hero > :global(.margin-note) {
		grid-area: note;
		margin-top: -0.75rem;
	}

	h1 {
		grid-area: title;
		margin: 0;
		color: var(--ink);
		font-size: clamp(2.5rem, 6vw, 4.125rem);
		font-weight: 600;
		line-height: 1.08;
	}

	.tagline {
		grid-area: tagline;
		max-width: 34em;
		margin: 0;
		color: var(--ink-muted);
		font-size: var(--sl-text-xl);
		line-height: 1.6;
	}

	.actions {
		grid-area: actions;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
	}

	.install {
		grid-area: install;
		justify-self: start;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		max-width: 100%;
		box-sizing: border-box;
		padding: 0.25rem 0.25rem 0.25rem 1.125rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		font-size: var(--sl-text-sm);
	}

	.install code {
		overflow-x: auto;
		white-space: nowrap;
	}

	.prompt {
		color: var(--ink-muted);
	}

	.install button {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--ink-muted);
		cursor: pointer;
	}

	.install button:hover,
	.install button[data-copied] {
		color: var(--ink);
	}

	@container (min-width: 52rem) {
		.hero {
			grid-template-columns: minmax(0, 42.5rem) 14rem;
			grid-template-areas: "title ." "tagline note" "actions ." "install .";
			justify-content: start;
			column-gap: 2.5rem;
		}

		.hero > :global(.margin-note) {
			--margin-note-up: none;
			--margin-note-left: block;
			align-self: start;
			margin-top: 0.2rem;
		}
	}
</style>
