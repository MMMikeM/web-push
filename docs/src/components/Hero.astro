---
import { LinkButton } from "@astrojs/starlight/components";
import { project } from "../project.ts";
import MarginNote from "./MarginNote.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const highlight = data.heroHighlight;
const note = data.heroNote;
const [beforeAnchor, afterAnchor] =
	tagline && note && tagline.includes(note.target) ? tagline.split(note.target) : [tagline];
const [beforeHighlight, afterHighlight] =
	highlight && title.includes(highlight) ? title.split(highlight) : [title];

const install = `npm install ${project.name}`;
const issueUrl = `${project.repositoryUrl}/issues/new`;
const published = new Date().toLocaleDateString("en-GB", { month: "long", year: "numeric" });
---

<div class="rfc-header decoration" data-pagefind-ignore>
	<p>
		<span class="wide-only">Independent Submission</span>
		<span class="narrow-only"
			>Informational · {project.initialledAuthor} · <a href="https://thelazyweb.dev">thelazyweb.dev</a></span
		>
		<span>Request for Comments: <a href={issueUrl}>open an issue</a></span>
		<span class="wide-only">Category: Informational</span>
	</p>
	<p class="end wide-only">
		<span>{project.initialledAuthor}</span>
		<a href="https://thelazyweb.dev">thelazyweb.dev</a>
		<span>{published}</span>
	</p>
</div>

<div class="lead">
	<div class="hero">
		<h1 id="_top" data-page-title>
			{beforeHighlight}{afterHighlight !== undefined && <mark>{highlight}</mark>}{afterHighlight}
		</h1>
		{
			tagline && (
				<div class="tagline">
					<p>
						{beforeAnchor}
						{afterAnchor !== undefined && <u>{note?.target}</u>}
						{afterAnchor}
					</p>
					{note && (
						<MarginNote id="hero" anchor=".hero .tagline u" written>
							{note.text}
						</MarginNote>
					)}
				</div>
			)
		}
		<div class="actions">
			{actions.map(({ link, text, variant, icon }) => (
				<LinkButton href={link} variant={variant} icon={icon?.name}>
					{text}
				</LinkButton>
			))}
		</div>
		<div class="install">
			<code><span class="prompt decoration" aria-hidden="true">$ </span>{install}</code>
			<button type="button" class="decoration" aria-label="Copy the install command" data-copy={install}>
				<svg
					class="copy-icon"
					aria-hidden="true"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<rect x="9" y="9" width="12" height="12" rx="2"></rect>
					<path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
				</svg>
				<svg
					class="tick"
					aria-hidden="true"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M5 12.5l4.5 4.5L19 7.5" pathLength="1"></path>
				</svg>
			</button>
			<span class="sr-only" role="status" data-copy-status></span>
		</div>
	</div>
</div>

<script is:inline>
	// Deno's team joined Cloudflare in October 2026; the aside goes with the year.
	// Added in the browser, so the built page and its Markdown copy keep the plain tagline.
	if (Date.now() < Date.parse("2027-01-01T00:00:00Z")) {
		const tagline = document.querySelector(".hero .tagline > p");
		const text = [...(tagline?.childNodes ?? [])].find(
			(node) => node.nodeType === Node.TEXT_NODE && node.textContent.includes("Deno"),
		);
		if (text) {
			const at = text.textContent.indexOf("Deno") + "Deno".length;
			text.textContent = `${text.textContent.slice(0, at)} (RIP)${text.textContent.slice(at)}`;
		}
	}
</script>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
		button.addEventListener("click", async () => {
			await navigator.clipboard.writeText(button.dataset.copy ?? "");
			const status = button.parentElement?.querySelector("[data-copy-status]");
			button.dataset.copied = "";
			if (status) {
				status.textContent = "Copied";
			}
			setTimeout(() => {
				delete button.dataset.copied;
				if (status) {
					status.textContent = "";
				}
			}, 1500);
		});
	}
</script>

<style>
	.rfc-header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2xs) var(--space-xl);
		padding-top: var(--space-xl);
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-sm);
		line-height: var(--leading-body);
	}

	.rfc-header p {
		display: flex;
		flex-direction: column;
		margin: 0;
	}

	/* Grows what a finger can hit; the negative margin keeps the rows where they were. */
	.rfc-header a {
		margin-block: -0.875rem;
		padding-block: 0.875rem;
		color: var(--pen);
	}

	.rfc-header .end {
		text-align: end;
	}

	@media (max-width: 39.99rem) {
		.rfc-header {
			padding-top: var(--space-m);
			font-size: var(--text-xs);
		}

		.rfc-header .wide-only {
			display: none;
		}
	}

	@media (min-width: 40rem) {
		.rfc-header .narrow-only {
			display: none;
		}
	}

	.lead {
		container: page / inline-size;
	}

	/* Spaced by what follows: the tagline and its note need room before the buttons. */
	.hero {
		display: grid;
		padding-block: var(--space-l) var(--space-s);
		--after-title: var(--space-m);
		--after-tagline: var(--space-l);
	}

	h1 {
		margin: 0;
		color: var(--ink);
		font-size: var(--text-display);
		font-weight: 600;
		line-height: var(--leading-tight);
	}

	/*
	 * Source Serif's inline box is 1.38em tall, more than the heading's line height,
	 * so the yellow runs from just above the ascenders to just below the descenders
	 * and clears the line above.
	 */
	h1 mark {
		background: linear-gradient(transparent 19%, var(--highlight) 19% 97%, transparent 97%);
	}

	.tagline {
		position: relative;
		display: flex;
		flex-direction: column;
		max-width: 34em;
		margin-top: var(--after-title);
		color: var(--ink-muted);
		font-size: var(--text-xl);
		line-height: var(--leading-body);
	}

	.tagline p {
		margin: 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-xs) var(--space-s);
		margin-top: var(--after-tagline);
	}

	.actions :global(.sl-link-button) {
		min-height: var(--tap-target);
		align-items: center;
	}

	/*
	 * Tight enough that both buttons share a line on a 360px phone. The link goes
	 * below, close under them; its tap target is the gap.
	 */
	@media (max-width: 39.99rem) {
		.actions {
			gap: var(--space-2xs);
		}

		.actions :global(.sl-link-button:not(.minimal)) {
			padding-inline: var(--space-xs);
		}
	}

	.install {
		justify-self: start;
		display: flex;
		align-items: center;
		gap: var(--space-3xs);
		max-width: 100%;
		box-sizing: border-box;
		margin-top: var(--space-m);
		padding: var(--space-3xs) var(--space-3xs) var(--space-3xs) var(--space-s);
		border: 1px solid var(--line);
		border-radius: var(--radius-control);
		font-size: var(--text-sm);
	}

	.install code {
		overflow-x: auto;
		white-space: nowrap;
	}

	.prompt {
		color: var(--ink-muted);
	}

	.install button {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: var(--tap-target);
		height: var(--tap-target);
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--ink-muted);
		cursor: pointer;
	}

	.install button:hover {
		color: var(--ink);
	}

	/* Copied: the author's pen ticks it off, in the stroke the margin notes are drawn with. */
	.install .tick,
	.install button[data-copied] .copy-icon {
		display: none;
	}

	.install button[data-copied] .tick {
		display: block;
		color: var(--pen);
	}

	@media (prefers-reduced-motion: no-preference) {
		.install button[data-copied] .tick path {
			stroke-dasharray: 1;
			animation: tick-stroke 0.3s cubic-bezier(0.45, 0, 0.6, 0.95) both;
		}
	}

	@keyframes tick-stroke {
		from {
			stroke-dashoffset: 1;
		}

		to {
			stroke-dashoffset: 0;
		}
	}

	@container page (min-width: 52rem) {
		.hero {
			padding-block: var(--space-xl) var(--space-l);
			--after-title: var(--space-l);
			--after-tagline: var(--space-xl);
		}
	}
</style>
