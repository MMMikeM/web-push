---
type Approach = "side" | "above" | "below";

interface Props {
	/** The `for` shared by the margin note and its target. */
	for: string;
	/**
	 * How the arrow reaches its target without crossing text: from the right
	 * along the target's line, arcing down onto it from the gap above, or up
	 * onto it from the gap below.
	 */
	approach: Approach;
}

const { for: id, approach } = Astro.props;
const shafts: Record<Approach, string> = {
	side: "M100 0C100 85 97 100 80 100L0 100",
	above: "M100 100C100 0 0 0 0 100",
	below: "M100 100C30 100 0 70 0 0",
};
const anchors = `--note: --note-${id}; --target: --target-${id}`;
// The shaft sits in a div the insets stretch: an SVG positioned on its own keeps
// its viewBox's proportions and drops the bottom inset.
---

<div class="connector decoration" data-connector={id} data-approach={approach} style={anchors}>
	<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
		<path d={shafts[approach]}></path>
	</svg>
</div>
<svg
	class="head decoration"
	data-connector-head={id}
	data-approach={approach}
	style={anchors}
	viewBox="0 0 12 12"
	aria-hidden="true"
>
	<path d="M2 4L6 9L10 4"></path>
</svg>

<script>
	// The same geometry as the anchor() rules below, for browsers without them.
	const GAP = 6;
	const ARC = 28;

	type Box = { left: number; top: number; width: number; height: number };

	const shaft = (approach: string, note: DOMRect, target: DOMRect): Box => {
		const right = note.left - GAP;
		const centreX = target.left + target.width / 2;
		if (approach === "above") {
			return { left: centreX, top: target.top - ARC, width: right - centreX, height: ARC - 4 };
		}
		if (approach === "below") {
			const top = target.bottom + 4;
			return { left: centreX, top, width: right - centreX, height: note.top - GAP - top };
		}
		const left = target.right + 8;
		const top = note.top + GAP;
		return { left, top, width: right - left, height: target.top + target.height / 2 - top };
	};

	const head = (approach: string, target: DOMRect) => {
		const centreX = target.left + target.width / 2;
		if (approach === "above") return { left: centreX - 6, top: target.top - 13 };
		if (approach === "below") return { left: centreX - 6, top: target.bottom + 1 };
		return { left: target.right + 2, top: target.top + target.height / 2 - 6 };
	};

	const containingBlock = (element: Element) => {
		let block = element.parentElement;
		while (block && getComputedStyle(block).position === "static") {
			block = block.parentElement;
		}
		return block;
	};

	const place = () => {
		for (const connector of document.querySelectorAll<HTMLElement>("[data-connector]")) {
			const id = connector.dataset.connector;
			const approach = connector.dataset.approach ?? "side";
			const note = document.querySelector(`[data-note="${id}"]`);
			const target = document.querySelector(`[data-note-target="${id}"]`);
			const tip = document.querySelector<SVGElement>(`[data-connector-head="${id}"]`);
			const frame = containingBlock(connector);
			if (!note || !target || !tip || !frame || getComputedStyle(connector).display === "none") {
				continue;
			}
			const origin = frame.getBoundingClientRect();
			const box = shaft(approach, note.getBoundingClientRect(), target.getBoundingClientRect());
			Object.assign(connector.style, {
				left: `${box.left - origin.left}px`,
				top: `${box.top - origin.top}px`,
				width: `${Math.max(box.width, 1)}px`,
				height: `${Math.max(box.height, 1)}px`,
			});
			const point = head(approach, target.getBoundingClientRect());
			Object.assign(tip.style, {
				left: `${point.left - origin.left}px`,
				top: `${point.top - origin.top}px`,
			});
		}
	};

	if (!CSS.supports("anchor-name: --a")) {
		document.documentElement.dataset.connectors = "";
		void document.fonts.ready.then(place);
		new ResizeObserver(place).observe(document.documentElement);
	}
</script>

<style>
	.connector,
	.head {
		display: none;
		position: absolute;
		margin: 0;
		pointer-events: none;
	}

	.connector svg,
	.head {
		overflow: visible;
		fill: none;
		stroke: var(--pen);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.connector svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.connector path {
		vector-effect: non-scaling-stroke;
	}

	.head {
		width: 12px;
		height: 12px;
	}

	.head[data-approach="side"] {
		rotate: 90deg;
	}

	.head[data-approach="below"] {
		rotate: 180deg;
	}

	/* Only beside the text: below it, the note's own arrow points up at its target. */
	@container (min-width: 52rem) {
		:global(:root[data-connectors]) :is(.connector, .head) {
			display: block;
		}

		@supports (anchor-name: --a) {
			.connector,
			.head {
				display: block;
			}

			.connector {
				right: calc(anchor(var(--note) left) + 6px);
			}

			.connector[data-approach="side"] {
				left: calc(anchor(var(--target) right) + 8px);
				top: calc(anchor(var(--note) top) + 6px);
				bottom: anchor(var(--target) center);
			}

			.connector[data-approach="above"] {
				left: anchor(var(--target) center);
				top: calc(anchor(var(--target) top) - 28px);
				bottom: calc(anchor(var(--target) top) + 4px);
			}

			.connector[data-approach="below"] {
				left: anchor(var(--target) center);
				top: calc(anchor(var(--target) bottom) + 4px);
				bottom: calc(anchor(var(--note) top) + 6px);
			}

			.head[data-approach="side"] {
				left: calc(anchor(var(--target) right) + 2px);
				top: calc(anchor(var(--target) center) - 6px);
			}

			.head[data-approach="above"] {
				left: calc(anchor(var(--target) center) - 6px);
				top: calc(anchor(var(--target) top) - 13px);
			}

			.head[data-approach="below"] {
				left: calc(anchor(var(--target) center) - 6px);
				top: calc(anchor(var(--target) bottom) + 1px);
			}
		}
	}
</style>
