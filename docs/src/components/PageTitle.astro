---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { markdownHref } from "../routeData.ts";
import RuntimeSelect from "./RuntimeSelect.astro";

const { id, entry } = Astro.locals.starlightRoute;
const { runtimePicker } = entry.data;
---

{
	runtimePicker ? (
		<div class="title-row">
			<Default />
			<RuntimeSelect inline />
		</div>
	) : (
		<Default />
	)
}

{/* Fetch tools convert a page to Markdown and drop its <head>, so the alternate link
	never reaches an agent; a link in the body does. */}
<p class="markdown-copy" data-pagefind-ignore>
	<a href={markdownHref(id)} type="text/markdown">Markdown version of this page</a>
</p>

<style>
	/* Starlight gives the title a top margin; the row takes it, so both centre on one line. */
	.title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: 1rem;
	}

	.title-row :global(h1) {
		margin-top: 0;
	}

	.markdown-copy {
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
	}

	.markdown-copy a {
		color: var(--sl-color-gray-3);
	}

	.markdown-copy a:hover {
		color: var(--sl-color-white);
	}
</style>
