---
import Bell from "./NotificationIcon.astro";
---

<push-demo>
	<div class="trigger">
		<div class="controls not-content decoration" data-pagefind-ignore>
			<button type="button" data-send>
				<svg
					aria-hidden="true"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
					<path d="M10 21h4"></path>
				</svg>
				<span class="labels">
					<span class="first">Send me a test notification</span>
					<span class="again">Send another</span>
				</span>
			</button>
			<noscript><p>The demo needs JavaScript.</p></noscript>
		</div>
		<slot name="note" />
	</div>
	<div class="output">
		<div class="status not-content decoration" data-pagefind-ignore>
			<ol class="steps">
				<li data-step="allow">Allow notifications</li>
				<li data-step="subscribe">Subscribe this browser</li>
				<li data-step="send">Send from the Worker</li>
				<li data-step="arrive">Arrive on your screen</li>
			</ol>
			<div class="countdown" hidden>
				<span class="sending">Sending in <span class="seconds"></span></span>
				<span class="drain"></span>
			</div>
			<p class="message" role="status" aria-live="polite">
				It arrives as a real notification, and here on the page.
			</p>
		</div>
		<div class="code"><slot /></div>
	</div>
	<div class="toast notification not-content decoration" role="status" aria-live="polite" hidden>
		<Bell />
		<div class="notification-text">
			<p class="meta"><span>web-push.thelazyweb.dev</span><span>now</span></p>
			<p class="title"></p>
			<p class="body"></p>
		</div>
		<button type="button" class="toast-close" aria-label="Dismiss" data-dismiss>×</button>
	</div>
</push-demo>

<script>
	import {
		isPushSupported,
		requestNotificationPermission,
		serializeSubscription,
		subscribe,
		unsubscribe,
	} from "../../../src/client.ts";

	const DEMO_URL = "/demo/push";
	const WORKER_URL = "/push-demo-sw.js";
	// A scope of its own keeps the demo's service worker from controlling the docs pages.
	const WORKER_SCOPE = "/push-demo/";
	// How long the docs Worker waits before its first send (worker/push-demo.ts).
	const SEND_DELAY_S = 5;
	const TOAST_MS = 10_000;

	const UNSUPPORTED =
		"This browser can’t receive push notifications here. On iPhone and iPad, Safari only allows them for sites added to the Home Screen.";
	const BLOCKED =
		"Notifications are blocked for this site. Allow them in the site settings, then try again.";
	// Chrome refuses push in a private window with an AbortError it only explains in
	// the console, and Brave does the same while its push service is turned off.
	const NO_PUSH_SERVICE =
		"This window can’t receive push notifications. If it’s a private window, try a normal one.";

	/** Whether a send request went out, or why it didn't. */
	type Outcome = { sent: true } | { sent: false; reason: string };

	const failed = (reason: string): Outcome => ({ sent: false, reason });

	/** Starts an element's CSS animations again from the beginning. */
	const replay = (element: Element) => {
		for (const animation of element.getAnimations()) {
			animation.cancel();
			animation.play();
		}
	};

	const isAbort = (error: unknown) => error instanceof DOMException && error.name === "AbortError";

	const post = (subscription: PushSubscription): Promise<Response> =>
		fetch(DEMO_URL, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify(serializeSubscription(subscription)),
		});

	const errorFrom = async (response: Response): Promise<Outcome> => {
		const { error } = (await response.json().catch(() => ({}))) as { error?: string };
		return failed(error ?? `The demo answered ${response.status}.`);
	};

	type Arrival = { title?: string; body?: string };

	const STEPS = ["allow", "subscribe", "send", "arrive"] as const;
	type Step = (typeof STEPS)[number];

	class PushDemo extends HTMLElement {
		// The push can land before the send request returns.
		#arrived = false;
		#step: Step = "allow";
		#countdown: ReturnType<typeof setInterval> | undefined;
		#toastTimer: ReturnType<typeof setTimeout> | undefined;

		connectedCallback() {
			this.querySelector("[data-send]")?.addEventListener("click", () => this.#send());
			this.querySelector("[data-dismiss]")?.addEventListener("click", () => this.#hideToast());
			navigator.serviceWorker?.addEventListener("message", (event) => {
				if (event.data?.type === "push-demo:received") {
					this.#arrive(event.data as Arrival);
				}
			});
			navigator.serviceWorker?.startMessages();
		}

		async #send() {
			const button = this.querySelector<HTMLButtonElement>("[data-send]")!;
			button.disabled = true;
			this.#arrived = false;
			this.#hideToast();
			this.#reach("allow");
			try {
				const outcome = await this.#subscribeAndSend();
				if (outcome.sent) {
					button.dataset.sent = "";
				}
				if (this.#arrived) {
					return;
				}
				if (outcome.sent) {
					this.#reach("arrive");
					this.#say("Sent. It should arrive in a few seconds.");
				} else {
					this.#fail(outcome.reason);
				}
			} catch (error) {
				console.error(error);
				const detail = error instanceof Error ? `${error.name}: ${error.message}` : String(error);
				this.#fail(`Something went wrong in the browser (${detail}). Try again.`);
			} finally {
				this.#stopCountdown();
				button.disabled = false;
			}
		}

		async #subscribeAndSend(): Promise<Outcome> {
			if (!isPushSupported()) {
				return failed(UNSUPPORTED);
			}
			// Asked first, while the click still counts as one: Firefox only shows
			// the prompt in response to a user action.
			if ((await requestNotificationPermission()) !== "granted") {
				return failed(BLOCKED);
			}
			this.#reach("subscribe");
			this.#say("Subscribing. The first time in a browser can take a little while.");
			const registration = await navigator.serviceWorker.register(WORKER_URL, {
				scope: WORKER_SCOPE,
			});
			const keyResponse = await fetch(DEMO_URL);
			if (!keyResponse.ok) {
				return errorFrom(keyResponse);
			}
			const { publicKey } = (await keyResponse.json()) as { publicKey: string };
			const result = await subscribe(publicKey, { registration }).catch((error: unknown) => {
				if (isAbort(error)) {
					return { status: "no push service" } as const;
				}
				throw error;
			});
			if (result.status === "no push service") {
				return failed(NO_PUSH_SERVICE);
			}
			if (result.status !== "subscribed") {
				return failed(UNSUPPORTED);
			}
			this.#startCountdown();
			let response = await post(result.subscription);
			// The push service dropped this browser's subscription, but the browser
			// still holds it and `subscribe` handed it back. Replace it once.
			if (response.status === 410) {
				await unsubscribe({ registration });
				const fresh = await subscribe(publicKey, { registration });
				if (fresh.status !== "subscribed") {
					return failed(UNSUPPORTED);
				}
				this.#startCountdown();
				response = await post(fresh.subscription);
			}
			return response.ok ? { sent: true } : errorFrom(response);
		}

		#startCountdown() {
			this.#stopCountdown();
			this.#reach("send");
			const countdown = this.querySelector<HTMLElement>(".countdown")!;
			const seconds = countdown.querySelector<HTMLElement>(".seconds")!;
			countdown.style.setProperty("--send-delay", `${SEND_DELAY_S}s`);
			countdown.hidden = false;
			replay(countdown.querySelector(".drain")!);
			let left = SEND_DELAY_S;
			const tick = () => {
				if (left > 0) {
					seconds.textContent = String(left);
					replay(seconds);
					this.#say("Switch to another tab or app to watch it arrive as a real notification.");
				} else {
					countdown.hidden = true;
					this.#say("Sending…");
				}
				left -= 1;
			};
			tick();
			this.#countdown = setInterval(tick, 1000);
		}

		#stopCountdown() {
			clearInterval(this.#countdown);
			this.#countdown = undefined;
			const countdown = this.querySelector<HTMLElement>(".countdown");
			if (countdown) {
				countdown.hidden = true;
			}
		}

		#arrive({ title, body }: Arrival) {
			this.#arrived = true;
			this.#stopCountdown();
			this.#reach("arrive", "done");
			this.#say("Arrived. Encrypted, signed and sent by this library on a Cloudflare Worker.");
			// Shown once the visitor is back, so a toast doesn't expire unseen.
			if (document.visibilityState === "visible") {
				this.#showToast(title, body);
			} else {
				const pageTitle = document.title;
				document.title = `(1) ${pageTitle}`;
				document.addEventListener(
					"visibilitychange",
					() => {
						document.title = pageTitle;
						this.#showToast(title, body);
					},
					{ once: true },
				);
			}
		}

		/** Shows the notification in `card`, or hides the card when there's none. */
		#fill(card: HTMLElement | null, notification?: Arrival) {
			if (!card) {
				return;
			}
			card.querySelector(".title")!.textContent = notification?.title ?? "";
			card.querySelector(".body")!.textContent = notification?.body ?? "";
			card.hidden = !notification;
		}

		#showToast(title = "", body = "") {
			const toast = this.querySelector<HTMLElement>(".toast");
			if (!toast) {
				return;
			}
			this.#fill(toast, { title, body });
			clearTimeout(this.#toastTimer);
			this.#toastTimer = setTimeout(() => this.#hideToast(), TOAST_MS);
		}

		#hideToast() {
			clearTimeout(this.#toastTimer);
			const toast = this.querySelector<HTMLElement>(".toast");
			if (toast) {
				toast.hidden = true;
			}
		}

		/** Marks the steps before `step` done, `step` itself with `state`, and the rest not started. */
		#reach(step: Step, state: "active" | "done" | "failed" = "active") {
			this.#step = step;
			const reached = STEPS.indexOf(step);
			for (const item of this.querySelectorAll<HTMLElement>(".steps [data-step]")) {
				const index = STEPS.indexOf(item.dataset.step as Step);
				if (index < reached) {
					item.dataset.state = "done";
				} else if (index === reached) {
					item.dataset.state = state;
				} else {
					delete item.dataset.state;
				}
			}
		}

		#fail(reason: string) {
			this.#reach(this.#step, "failed");
			this.#say(reason, { failed: true });
		}

		#say(message: string, { failed = false } = {}) {
			const status = this.querySelector<HTMLElement>(".message");
			if (status) {
				status.textContent = message;
				status.toggleAttribute("data-failed", failed);
			}
		}
	}

	customElements.define("push-demo", PushDemo);
</script>

<style>
	push-demo {
		container-type: inline-size;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	/* The margin note in its slot is positioned within it on wide pages. */
	.trigger {
		position: relative;
		display: flex;
		flex-direction: column;
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}

	[data-send] {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-height: 2.75rem;
		padding: 0.875rem 1.5rem;
		border: 1px solid var(--button);
		border-radius: 8px;
		background-color: var(--button);
		color: var(--button-text);
		font: inherit;
		font-family: var(--__sl-font-mono);
		font-size: var(--text-base);
		font-weight: 500;
		cursor: pointer;
	}

	/* Both labels share one cell, so the button keeps its width when it changes. */
	.labels {
		display: grid;
	}

	.labels > * {
		grid-area: 1 / 1;
	}

	[data-send]:not([data-sent]) .again,
	[data-send][data-sent] .first {
		visibility: hidden;
	}

	[data-send]:disabled {
		cursor: progress;
		opacity: 0.7;
	}

	button:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

	.output {
		display: grid;
		gap: 1.25rem;
	}

	.output > * {
		min-width: 0;
		margin: 0;
	}

	/* How far the demo has got, and what happened at the last step it reached. */
	.status {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		box-sizing: border-box;
		padding: 1.125rem;
		border: 1.5px dashed var(--line-strong);
		border-radius: 14px;
	}

	.steps {
		display: grid;
		gap: 0.375rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-sm);
	}

	.steps li {
		display: flex;
		gap: 0.625rem;
		margin: 0;
	}

	.steps li::before {
		content: "○";
		width: 1ch;
		color: var(--line-strong);
	}

	.steps [data-state] {
		color: var(--ink);
	}

	.steps [data-state="active"]::before {
		content: "●";
		color: var(--pen);
	}

	.steps [data-state="done"]::before {
		content: "✓";
		color: var(--pen);
	}

	.steps [data-state="failed"]::before {
		content: "×";
		color: var(--ink);
	}

	/* The five seconds before the Worker sends: time to switch away and see a real notification. */
	.countdown {
		display: grid;
		gap: 0.5rem;
		justify-items: start;
	}

	.countdown[hidden] {
		display: none;
	}

	.sending {
		padding-inline: 0.25em;
		background: var(--highlight);
		color: var(--highlight-ink);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-3xl);
		font-weight: 500;
		line-height: 1.3;
	}

	.seconds {
		display: inline-block;
	}

	.drain {
		justify-self: stretch;
		height: 3px;
		background: var(--pen);
		transform-origin: left;
	}

	@media (prefers-reduced-motion: no-preference) {
		.steps [data-state="active"]::before {
			animation: step-pulse 1s ease-in-out infinite alternate;
		}

		.seconds {
			animation: second-pop 300ms ease-out;
		}

		.countdown:not([hidden]) .drain {
			animation: drain var(--send-delay) linear forwards;
		}
	}

	@keyframes second-pop {
		from {
			scale: 1.25;
		}
	}

	@keyframes drain {
		to {
			transform: scaleX(0);
		}
	}

	@keyframes step-pulse {
		to {
			opacity: 0.3;
		}
	}

	.message {
		margin: 0;
		color: var(--ink-muted);
		font-size: var(--text-base);
	}

	.message[data-failed] {
		color: var(--ink);
	}

	.code :global(.expressive-code) {
		margin: 0;
	}

	/* In the filename bar, where it covers no code on a touch screen that always shows it. */
	.code :global(.frame.has-title .copy) {
		inset-block-start: 0;
	}

	.code :global(.frame.has-title .copy button) {
		max-height: 2.1875rem;
	}

	/* Small enough on a phone that the call's first line wraps after its first argument. */
	@container (max-width: 25rem) {
		.code :global(.expressive-code) {
			--ec-codeFontSize: 0.75rem;
		}
	}

	@container (min-width: 44rem) {
		.output {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		}
	}

	/* Laid out like a desktop notification: icon, source and time, title, body. */
	.notification {
		display: flex;
		align-items: flex-start;
		gap: 0.875rem;
		padding: 1rem 1.125rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		background-color: var(--notif-bg);
		font-family: var(--__sl-font-mono);
	}

	.notification[hidden] {
		display: none;
	}

	.notification-text {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.notification p {
		margin: 0;
	}

	.meta {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		color: var(--ink-muted);
		font-size: var(--text-xs);
	}

	.title {
		color: var(--ink);
		font-size: var(--text-sm);
		font-weight: 500;
	}

	.body {
		color: var(--ink-muted);
		font-size: var(--text-sm);
	}

	.toast {
		position: fixed;
		inset-block-end: 1.5rem;
		inset-inline-end: 1.5rem;
		z-index: 100;
		width: min(28rem, calc(100vw - 2rem));
		box-sizing: border-box;
		box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
		animation: toast-in 220ms ease-out;
	}

	.toast-close {
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		margin: -0.25rem -0.375rem 0 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--ink-muted);
		font-size: var(--text-xl);
		line-height: 1;
		cursor: pointer;
	}

	.toast-close:hover {
		color: var(--ink);
	}

	@media (max-width: 30rem) {
		.toast {
			inset-inline: 1rem;
			inset-block-end: 1rem;
			width: auto;
		}
	}

	@keyframes toast-in {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.toast {
			animation: none;
		}
	}
</style>
