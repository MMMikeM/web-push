---
import Bell from "./NotificationIcon.astro";
---

<push-demo>
	<div class="controls not-content decoration" data-pagefind-ignore>
		<button type="button" data-send>
			<svg
				aria-hidden="true"
				width="18"
				height="18"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
				<path d="M10 21h4"></path>
			</svg>
			<span data-label>Send me a test notification</span>
		</button>
		<p class="status" role="status" aria-live="polite"></p>
		<noscript><p>The demo needs JavaScript.</p></noscript>
	</div>
	<div class="output">
		<div class="preview not-content decoration" data-pagefind-ignore>
			<p class="empty">Your notification lands here, and on your screen.</p>
			<div class="notification" hidden>
				<Bell />
				<div class="notification-text">
					<p class="meta"><span>web-push.thelazyweb.dev</span><span>now</span></p>
					<p class="title"></p>
					<p class="body"></p>
				</div>
			</div>
		</div>
		<div class="code"><slot /></div>
	</div>
	<div class="toast notification not-content decoration" role="status" aria-live="polite" hidden>
		<Bell />
		<div class="notification-text">
			<p class="meta"><span>web-push.thelazyweb.dev</span><span>now</span></p>
			<p class="title"></p>
			<p class="body"></p>
		</div>
		<button type="button" class="toast-close" aria-label="Dismiss" data-dismiss>×</button>
	</div>
</push-demo>

<script>
	import {
		isPushSupported,
		requestNotificationPermission,
		serializeSubscription,
		subscribe,
		unsubscribe,
	} from "../../../src/client.ts";

	const DEMO_URL = "/demo/push";
	const WORKER_URL = "/push-demo-sw.js";
	// A scope of its own keeps the demo's service worker from controlling the docs pages.
	const WORKER_SCOPE = "/push-demo/";
	// How long the docs Worker waits before its first send (worker/push-demo.ts).
	const SEND_DELAY_S = 5;
	const TOAST_MS = 10_000;

	const UNSUPPORTED =
		"This browser can't receive push notifications here. On iPhone and iPad, Safari only allows them for sites added to the Home Screen.";

	const post = (subscription: PushSubscription): Promise<Response> =>
		fetch(DEMO_URL, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify(serializeSubscription(subscription)),
		});

	const errorFrom = async (response: Response): Promise<string> => {
		const { error } = (await response.json().catch(() => ({}))) as { error?: string };
		return error ?? `The demo answered ${response.status}.`;
	};

	type Arrival = { title?: string; body?: string };

	class PushDemo extends HTMLElement {
		// The push can land before the send request returns.
		#arrived = false;
		#countdown: ReturnType<typeof setInterval> | undefined;
		#toastTimer: ReturnType<typeof setTimeout> | undefined;

		connectedCallback() {
			this.querySelector("[data-send]")?.addEventListener("click", () => this.#send());
			this.querySelector("[data-dismiss]")?.addEventListener("click", () => this.#hideToast());
			navigator.serviceWorker?.addEventListener("message", (event) => {
				if (event.data?.type === "push-demo:received") {
					this.#arrive(event.data as Arrival);
				}
			});
			navigator.serviceWorker?.startMessages();
		}

		async #send() {
			const button = this.querySelector<HTMLButtonElement>("[data-send]")!;
			button.disabled = true;
			this.#arrived = false;
			this.#hideToast();
			this.#fill(this.querySelector(".preview .notification"));
			try {
				const outcome = await this.#subscribeAndSend();
				if (!this.#arrived) {
					this.#say(outcome);
				}
			} catch (error) {
				console.error(error);
				const detail = error instanceof Error ? `${error.name}: ${error.message}` : String(error);
				this.#say(`Something went wrong in the browser (${detail}). Try again.`);
			} finally {
				this.#stopCountdown();
				button.disabled = false;
				button.querySelector("[data-label]")!.textContent = "Send another";
			}
		}

		async #subscribeAndSend(): Promise<string> {
			if (!isPushSupported()) {
				return UNSUPPORTED;
			}
			// Asked first, while the click still counts as one: Firefox only shows
			// the prompt in response to a user action.
			if ((await requestNotificationPermission()) !== "granted") {
				return "Notifications are blocked for this site. Allow them in the site settings, then try again.";
			}
			this.#say("Subscribing. The first time in a browser can take a little while.");
			const registration = await navigator.serviceWorker.register(WORKER_URL, {
				scope: WORKER_SCOPE,
			});
			const keyResponse = await fetch(DEMO_URL);
			if (!keyResponse.ok) {
				return errorFrom(keyResponse);
			}
			const { publicKey } = (await keyResponse.json()) as { publicKey: string };
			const result = await subscribe(publicKey, { registration });
			if (result.status !== "subscribed") {
				return UNSUPPORTED;
			}
			this.#startCountdown();
			let response = await post(result.subscription);
			// The push service dropped this browser's subscription, but the browser
			// still holds it and `subscribe` handed it back. Replace it once.
			if (response.status === 410) {
				await unsubscribe({ registration });
				const fresh = await subscribe(publicKey, { registration });
				if (fresh.status !== "subscribed") {
					return UNSUPPORTED;
				}
				this.#startCountdown();
				response = await post(fresh.subscription);
			}
			return response.ok ? "Sent. It should arrive in a few seconds." : errorFrom(response);
		}

		#startCountdown() {
			this.#stopCountdown();
			let left = SEND_DELAY_S;
			const tick = () => {
				this.#say(
					left > 0
						? `Sending in ${left}. Switch to another tab or app to watch it arrive as a real notification.`
						: "Sending…",
				);
				left -= 1;
			};
			tick();
			this.#countdown = setInterval(tick, 1000);
		}

		#stopCountdown() {
			clearInterval(this.#countdown);
			this.#countdown = undefined;
		}

		#arrive({ title, body }: Arrival) {
			this.#arrived = true;
			this.#stopCountdown();
			this.#say("Arrived. Encrypted, signed and sent by this library on a Cloudflare Worker.");
			this.#fill(this.querySelector(".preview .notification"), { title, body });
			// Shown once the visitor is back, so a toast doesn't expire unseen.
			if (document.visibilityState === "visible") {
				this.#showToast(title, body);
			} else {
				const pageTitle = document.title;
				document.title = `(1) ${pageTitle}`;
				document.addEventListener(
					"visibilitychange",
					() => {
						document.title = pageTitle;
						this.#showToast(title, body);
					},
					{ once: true },
				);
			}
		}

		/** Shows the notification in `card`, or hides the card when there's none. */
		#fill(card: HTMLElement | null, notification?: Arrival) {
			if (!card) {
				return;
			}
			card.querySelector(".title")!.textContent = notification?.title ?? "";
			card.querySelector(".body")!.textContent = notification?.body ?? "";
			card.hidden = !notification;
			card
				.closest(".preview")
				?.querySelector(".empty")
				?.toggleAttribute("hidden", Boolean(notification));
		}

		// Only when the preview card is out of view, so the page never shows two of the same notification.
		#showToast(title = "", body = "") {
			const preview = this.querySelector(".preview")?.getBoundingClientRect();
			if (preview && preview.bottom > 0 && preview.top < window.innerHeight) {
				return;
			}
			const toast = this.querySelector<HTMLElement>(".toast");
			if (!toast) {
				return;
			}
			this.#fill(toast, { title, body });
			clearTimeout(this.#toastTimer);
			this.#toastTimer = setTimeout(() => this.#hideToast(), TOAST_MS);
		}

		#hideToast() {
			clearTimeout(this.#toastTimer);
			const toast = this.querySelector<HTMLElement>(".toast");
			if (toast) {
				toast.hidden = true;
			}
		}

		#say(message: string) {
			const status = this.querySelector(".status");
			if (status) {
				status.textContent = message;
			}
		}
	}

	customElements.define("push-demo", PushDemo);
</script>

<style>
	push-demo {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}

	[data-send] {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-height: 2.75rem;
		padding: 0.875rem 1.5rem;
		border: 1px solid var(--button);
		border-radius: 8px;
		background-color: var(--button);
		color: var(--button-text);
		font: inherit;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-base);
		font-weight: 500;
		cursor: pointer;
	}

	[data-send]:disabled {
		cursor: progress;
		opacity: 0.7;
	}

	button:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

	.status {
		flex: 1 1 16rem;
		margin: 0;
		color: var(--ink-muted);
		font-size: var(--sl-text-sm);
	}

	.status:empty {
		display: none;
	}

	.output {
		display: grid;
		gap: 1.25rem;
	}

	.output > * {
		min-width: 0;
		margin: 0;
	}

	.preview {
		display: flex;
		max-width: 26rem;
	}

	.empty {
		display: flex;
		flex-grow: 1;
		align-items: center;
		justify-content: center;
		min-height: 5.5rem;
		margin: 0;
		padding: 1rem 1.125rem;
		border: 1px dashed var(--line-strong);
		border-radius: 14px;
		color: var(--ink-muted);
		font-size: var(--sl-text-base);
		text-align: center;
	}

	.empty[hidden] {
		display: none;
	}

	.code :global(.expressive-code) {
		margin: 0;
	}

	/* Laid out like a desktop notification: icon, source and time, title, body. */
	.notification {
		display: flex;
		flex-grow: 1;
		align-items: flex-start;
		gap: 0.875rem;
		align-self: flex-start;
		padding: 1rem 1.125rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		background-color: var(--notif-bg);
		font-family: var(--__sl-font-mono);
	}

	.notification[hidden] {
		display: none;
	}

	.notification-text {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.notification p {
		margin: 0;
	}

	.meta {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		color: var(--ink-muted);
		font-size: var(--sl-text-xs);
	}

	.title {
		color: var(--ink);
		font-size: var(--sl-text-sm);
		font-weight: 500;
	}

	.body {
		color: var(--ink-muted);
		font-size: var(--sl-text-sm);
	}

	.toast {
		position: fixed;
		inset-block-end: 1.5rem;
		inset-inline-end: 1.5rem;
		z-index: 100;
		width: min(22rem, calc(100vw - 2rem));
		box-sizing: border-box;
		box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
		animation: toast-in 220ms ease-out;
	}

	.toast-close {
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		margin: -0.25rem -0.375rem 0 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: var(--ink-muted);
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
	}

	.toast-close:hover {
		color: var(--ink);
	}

	@media (max-width: 30rem) {
		.toast {
			inset-inline: 1rem;
			inset-block-end: 1rem;
			width: auto;
		}
	}

	@keyframes toast-in {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.toast {
			animation: none;
		}
	}
</style>
