---
interface Props {
	/** Numbers the items as subsections: 2.1, 2.2 and so on. */
	section: number;
}

const { section } = Astro.props;
---

<div class="pieces" style={`--section: "${section}."`}>
	<slot />
</div>

<style>
	/* A size container has no width of its own to fit a column to, so it takes the text's measure. */
	.pieces {
		container-type: inline-size;
		width: 37em;
		max-width: 100%;
	}

	.pieces :global(ol) {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: piece;
		border-top: 1px solid var(--line);
	}

	/* Each item holds a link and a span; the number is its ::before. */
	.pieces :global(li) {
		counter-increment: piece;
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		column-gap: 0.875rem;
		margin: 0;
		padding-block: 0.25rem 1rem;
		border-bottom: 1px solid var(--line);
		line-height: var(--leading-body);
	}

	.pieces :global(li::before) {
		content: var(--section) counter(piece);
		color: var(--ink-muted);
		font-family: var(--__sl-font-mono);
		font-size: var(--text-sm);
	}

	.pieces :global(li > a) {
		display: flex;
		align-items: center;
		min-height: var(--tap-target);
		text-decoration: none;
	}

	.pieces :global(li > a code) {
		padding: 0;
		background: none;
		color: var(--ink);
		font-size: var(--text-base);
	}

	.pieces :global(li > span) {
		grid-column: 1 / -1;
	}

	@container (min-width: 32rem) {
		.pieces :global(li) {
			grid-template-columns: 2.75rem 9.375rem 1fr;
			align-items: baseline;
			column-gap: var(--space-s);
			padding-block: 1.125rem;
		}

		.pieces :global(li > a) {
			display: inline;
			min-height: 0;
		}

		.pieces :global(li > span) {
			grid-column: auto;
		}
	}
</style>
