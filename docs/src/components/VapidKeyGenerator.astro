---
const FIELDS = [
	{ name: "public", label: "Public key", env: "VAPID_PUBLIC_KEY" },
	{ name: "private", label: "Private key", env: "VAPID_PRIVATE_KEY" },
];
---

<vapid-key-generator class="not-content">
	{
		FIELDS.map(({ name, label }) => (
			<div class="field">
				<label for={`vapid-${name}`}>{label}</label>
				<div class="row">
					<input
						id={`vapid-${name}`}
						data-key={name}
						readonly
						spellcheck="false"
						autocomplete="off"
						placeholder="Generating…"
					/>
					<button type="button" data-copy={name}>
						Copy
					</button>
				</div>
			</div>
		))
	}
	<div class="actions">
		<button type="button" class="primary" data-generate>New key pair</button>
		<button type="button" data-copy="env">Copy as .env</button>
		<span class="status" role="status" aria-live="polite"></span>
	</div>
	<noscript>
		<p>The generator needs JavaScript. The code below makes the same pair.</p>
	</noscript>
</vapid-key-generator>

<script>
	import { generateVapidKeys } from "../../../src/vapid.ts";

	class VapidKeyGenerator extends HTMLElement {
		#keys: { publicKey: string; privateKey: string } | undefined;

		connectedCallback() {
			this.querySelector("[data-generate]")?.addEventListener("click", () => this.#generate());
			for (const button of this.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
				button.addEventListener("click", () => this.#copy(button.dataset.copy ?? ""));
			}
			this.#generate();
		}

		async #generate() {
			this.#keys = await generateVapidKeys();
			this.#field("public").value = this.#keys.publicKey;
			this.#field("private").value = this.#keys.privateKey;
			this.#say("");
		}

		#field(name: string): HTMLInputElement {
			return this.querySelector<HTMLInputElement>(`[data-key="${name}"]`)!;
		}

		async #copy(what: string) {
			if (!this.#keys) {
				return;
			}
			const { publicKey, privateKey } = this.#keys;
			const text =
				what === "public"
					? publicKey
					: what === "private"
						? privateKey
						: `VAPID_PUBLIC_KEY=${publicKey}\nVAPID_PRIVATE_KEY=${privateKey}\nVAPID_SUBJECT=mailto:you@example.com\n`;
			try {
				await navigator.clipboard.writeText(text);
				this.#say(what === "env" ? "Copied as .env" : `Copied the ${what} key`);
			} catch {
				// Clipboard access can be refused; leave the text selected to copy by hand.
				if (what !== "env") {
					this.#field(what).select();
				}
				this.#say("Couldn't reach the clipboard");
			}
		}

		#say(message: string) {
			const status = this.querySelector(".status");
			if (status) {
				status.textContent = message;
			}
		}
	}

	customElements.define("vapid-key-generator", VapidKeyGenerator);
</script>

<style>
	vapid-key-generator {
		display: grid;
		gap: 1rem;
		margin-block: 1.5rem;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background-color: var(--sl-color-gray-7, var(--sl-color-gray-6));
	}

	.field {
		display: grid;
		gap: 0.375rem;
	}

	label {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.row {
		display: flex;
		gap: 0.5rem;
	}

	input {
		flex: 1;
		min-width: 0;
		min-height: 2.75rem;
		padding-inline: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background-color: var(--sl-color-black);
		color: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		/* Below 16px, iOS zooms the page when the field takes focus. */
		font-size: var(--text-base);
		text-overflow: ellipsis;
	}

	button {
		min-height: 2.75rem;
		padding-inline: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		font: inherit;
		font-family: var(--__sl-font-mono);
		font-size: var(--text-sm);
		cursor: pointer;
		white-space: nowrap;
	}

	button:hover {
		border-color: var(--sl-color-gray-3);
	}

	button.primary {
		border-color: var(--button);
		background-color: var(--button);
		color: var(--button-text);
	}

	:is(button, input):focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}

	.status {
		font-size: var(--text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
