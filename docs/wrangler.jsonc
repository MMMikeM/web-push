{
	"name": "web-push-docs",
	"compatibility_date": "2026-10-01",
	"main": "worker/index.ts",
	"routes": [{ "pattern": "web-push.thelazyweb.dev", "custom_domain": true }],
	"workers_dev": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		// The Worker only negotiates page URLs; built assets go straight to the asset server,
		// the only responses public/_headers reaches. robots.txt skips it so crawler
		// fetches aren't logged as views.
		"run_worker_first": ["/*", "!/_astro/*", "!/pagefind/*", "!/robots.txt"],
	},
	// Page and Markdown views, logged server-side. Query them with the SQL API:
	// POST api.cloudflare.com/client/v4/accounts/<id>/analytics_engine/sql
	"analytics_engine_datasets": [{ "binding": "VIEWS", "dataset": "web_push_docs_views" }],
}
